# Segredos locais: python scripts/configurar_dev.py
DJANGO_SECRET_KEY=
GUARDIAO_SERVICE_TOKEN=

# PostgreSQL local e role comum da aplicação
POSTGRES_DB=palacio_local
POSTGRES_USER=pm_bootstrap
POSTGRES_PASSWORD=
PM_APP_DB_PASSWORD=
DATABASE_URL=postgresql://pm_app:@database:5432/palacio_local

# Desenvolvimento local
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.localhost,django
PALACIO_BASE_DOMAIN=localhost
PUBLIC_APP_URL=http://localhost:8000
