    USUARIO {
        uuid id PK
        string nome_usuario
        string email
        boolean ativo
    }
    PERFIL_MEMBRO {
        bigint id PK
        uuid usuario_id FK
        string biografia
        string criado_em
        string atualizado_em
    }
    ORGANIZACAO {
        uuid id PK
        string slug
        string nome
        string nome_legal
        string status
        string criado_em
        string atualizado_em
    }
    IDENTIDADE_ORGANIZACAO {
        uuid id PK
        uuid organizacao_id FK
        string nome_exibicao
        string logo
        string cor_primaria
        string cor_destaque
        string cor_fundo
    }
    DOMINIO_ORGANIZACAO {
        uuid id PK
        uuid organizacao_id FK
        string hostname
        string tipo
        boolean principal
        string status_verificacao
        string verificado_em
    }
    MEMBRO_ORGANIZACAO {
        uuid id PK
        uuid organizacao_id FK
        uuid usuario_id FK
        string papel
        string status
        string entrou_em
    }
    CONVITE_ORGANIZACAO {
        uuid id PK
